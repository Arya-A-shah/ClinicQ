# Copy this file to .env and fill it in. Never commit .env to GitHub.

# Local MongoDB (what you have installed) or a MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/clinicq

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

PORT=4000
CLINIC_TZ=Asia/Kolkata

# Local testing only: shows a "dev login" button so you can test without Google.
# Ignored when NODE_ENV=production.
DEV_LOGIN=true

# Shown at the top of the patient page
CLINIC_NAME=My Clinic
